{
  "name": "future-electronics-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the Future Electronics Product Information API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "future-electronics-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "live-check": "tsx scripts/live-check.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "bundle": "node scripts/bundle.mjs",
    "pack:mcpb": "node scripts/pack-mcpb.mjs"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}
